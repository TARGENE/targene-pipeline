includeConfig 'ukb.config'

params {
    TRAITS_DATASET = "${projectDir}/test/assets/dataset.csv"
    QC_FILE = "${projectDir}/test/assets/qc_file.csv"
    ESTIMANDS_CONFIG = "${projectDir}/test/assets/gwas_config_binary.yaml"
    UKB_WITHDRAWAL_LIST = "${projectDir}/test/assets/withdrawal_list.txt"
    UKB_CONFIG = "${projectDir}/test/assets/ukbconfig_gwas_binary.yaml"

    // 2-SNP GWAS: subset the analysis variants to two SNPs (both on chr1).
    // PCA confounders still use the genome-wide BED_FILES (chr1,2,3).
    TARGET_BED_FILES = "${projectDir}/test/assets/unphased_bed/ukb_chr1.{bed,bim,fam}"
    SUBSET_FILE = "${projectDir}/test/assets/subset_2snps.txt"

    // TarGWAS report with genotype-count case/control split on the binary outcome.
    REPORT = true
    REPORT_SAMPLE_ID_COL = "SAMPLE_ID"
    REPORT_OUTCOME_COL = "I10 Essential hypertension"
}

process {
    memory = '4G'

    withLabel: bigmem {
        memory = '4G'
    }

    withLabel: multithreaded {
        cpus = 1
    }

    withName: EstimationInputs {
        memory = '4G'
        cpus = 1
    }

    withName: TMLE {
        memory = '4G'
    }
}
